{
  "name": "n8n-nodes-adscrawl",
  "version": "0.1.0",
  "description": "Extract rendered public webpages as HTML, Markdown, or structured JSON in n8n.",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "homepage": "https://github.com/AdsCrawl/n8n-nodes-adscrawl#readme",
  "bugs": {
    "url": "https://github.com/AdsCrawl/n8n-nodes-adscrawl/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "AdsCrawl",
    "web scraping",
    "data extraction"
  ],
  "author": {
    "name": "AdsCrawl",
    "email": "support@adscrawl.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdsCrawl/n8n-nodes-adscrawl.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "pnpm run build && node --test",
    "check": "pnpm run lint && pnpm run test",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/AdscrawlApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Adscrawl/Adscrawl.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.56.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "21.1.2",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
